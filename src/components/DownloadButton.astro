---
import Button from './buttons/Button.astro';
import { getLangFromUrl, useTranslations } from '../i18n/ui.js';

const { service, large, compact } = Astro.props;
const t = useTranslations(getLangFromUrl(Astro.url));

const ready = Boolean(service.downloadReady && service.downloadUrl);
const labelKey =
	service.downloadKind === 'chrome-store'
		? 'detail.downloadStore'
		: 'detail.downloadWindows';
const label = compact ? t('card.download') : t(labelKey);
---

{
	ready ? (
		<Button href={service.downloadUrl} large={large} newTab>
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" slot="icon">
				<path d="M12 3.5v11" />
				<path d="M7.5 10.5 12 15l4.5-4.5" />
				<path d="M4.5 18.5h15" />
			</svg>
			{label}
		</Button>
	) : (
		<Button disabled large={large}>{t('card.comingSoon')}</Button>
	)
}
