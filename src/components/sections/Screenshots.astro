---
import { getLangFromUrl, useTranslations } from '../../i18n/ui.js';

const { service } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const shots = service.screenshots ?? [];
const captions = service[lang].screenshotCaptions ?? [];
---

{
	shots.length > 0 ? (
		<ul class:list={['shots', { 'shots--phone': service.screenshotLayout === 'phone' }]}>
			{shots.map((shot, index) => (
				<li class="shots__item">
					<img
						class="shots__img"
						src={shot.src}
						width={shot.width}
						height={shot.height}
						alt={captions[index] ?? service[lang].name}
						loading={index === 0 ? 'eager' : 'lazy'}
						decoding="async"
					/>
					{captions[index] && <p class="shots__caption">{captions[index]}</p>}
				</li>
			))}
		</ul>
	) : (
		<div class="shots__placeholder">
			<p>{t('detail.screenshotsPending')}</p>
		</div>
	)
}

<style>
	.shots {
		margin: 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}
	/* 휴대폰 세로 화면: 한 줄에 두 장, 좁은 화면에서는 한 장 */
	.shots--phone {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 2rem 1.5rem;
		/* 세로로 긴 화면이라 폭을 줄여 한 장이 한 화면 안에 들어오게 합니다. */
		max-width: 34rem;
		margin: 0 auto;
	}
	@media (max-width: 480px) {
		.shots--phone {
			grid-template-columns: minmax(0, 1fr);
			max-width: 20rem;
			margin: 0 auto;
		}
	}
	.shots__img {
		width: 100%;
		height: auto;
		display: block;
		background-color: var(--theme-surface-1);
		border: 1px solid var(--theme-border);
		border-radius: var(--theme-shape-radius-sm);
	}
	.shots__caption {
		margin: 0.75rem 0 0 0;
		font-size: var(--font-size-sm);
		color: var(--theme-muted);
	}
	.shots__placeholder {
		display: grid;
		place-items: center;
		aspect-ratio: 16 / 10;
		background-color: var(--theme-surface-1);
		border: 1px dashed var(--theme-border);
		border-radius: var(--theme-shape-radius-sm);
	}
	.shots__placeholder p {
		margin: 0;
		color: var(--theme-muted);
	}
</style>
