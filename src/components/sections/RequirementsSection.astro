---
const { requirements } = Astro.props;
---

<dl class="requirements">
	{
		requirements.map((item) => (
			<div class="requirements__row">
				<dt>{item.label}</dt>
				<dd>{item.value}</dd>
			</div>
		))
	}
</dl>

<style>
	.requirements {
		margin: 0;
		border: 1px solid var(--theme-border);
		border-radius: var(--theme-shape-radius-sm);
		overflow: hidden;
	}
	.requirements__row {
		display: grid;
		grid-template-columns: 12rem 1fr;
		gap: 1rem;
		padding: 0.9rem 1.25rem;
		border-bottom: 1px solid var(--theme-border);
	}
	.requirements__row:last-child {
		border-bottom: none;
	}
	.requirements dt {
		margin: 0;
		font-weight: 700;
	}
	.requirements dd {
		margin: 0;
		color: var(--theme-muted);
	}

	@media (max-width: 600px) {
		.requirements__row {
			grid-template-columns: 1fr;
			gap: 0.15rem;
		}
	}
</style>
