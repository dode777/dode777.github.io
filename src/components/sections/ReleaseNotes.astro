---
import ReleaseItem from './ReleaseItem.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/ui.js';
import { downloadableVersions } from '../../config/services.js';
import { resolveReleases } from '../../lib/releases.js';

const { service } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const content = service[lang];

const { entries } = await resolveReleases(service, lang);
// 버전별 설치 파일은 Windows 프로그램에만 있습니다(웹앱은 항상 최신).
const downloadable = service.downloadKind === 'windows' ? downloadableVersions(entries) : new Set();

/*
 * 최신 버전과 같은 주 버전(2.x)은 그대로 펼치고, 그보다 오래된 주 버전(1.x …)은 하나씩 접어 둡니다.
 * 버전이 쌓여도 페이지가 길어지지 않게 하려는 것이고, 무엇을 보여 줄지는 그대로 릴리스 노트(md)가 정합니다.
 */
const major = (version) => String(version).split('.')[0];
const current = entries.filter((release) => major(release.version) === major(entries[0]?.version));
const archives = [];
for (const release of entries.slice(current.length)) {
	const last = archives.at(-1);
	if (last && last.major === major(release.version)) last.releases.push(release);
	else archives.push({ major: major(release.version), releases: [release] });
}
---

{
	entries.length > 0 ? (
		<>
			{content.releaseNote && <p class="releases__note">{content.releaseNote}</p>}

			<ol class="releases">
				{current.map((release, index) => (
					<ReleaseItem
						release={release}
						latest={index === 0}
						downloadable={downloadable.has(release.version)}
					/>
				))}
			</ol>

			{archives.map((archive) => (
				<details class="releases__archive">
					<summary>
						<span class="releases__archive-title">
							v{archive.major}.x {t('releases.archive')}
						</span>
						<span class="releases__archive-range">
							{archive.releases.at(-1).version} – {archive.releases[0].version}
						</span>
						<svg class="releases__chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m6 9 6 6 6-6" /></svg>
					</summary>
					<ol class="releases releases--archive">
						{archive.releases.map((release) => (
							<ReleaseItem release={release} downloadable={downloadable.has(release.version)} />
						))}
					</ol>
				</details>
			))}
		</>
	) : (
		<p class="releases__empty">{t('releases.unavailable')}</p>
	)
}

<style>
	.releases__note {
		margin-bottom: 2rem;
		color: var(--theme-muted);
		white-space: pre-line;
	}
	.releases {
		margin: 0;
		padding: 0;
		list-style: none;
		border-left: 2px solid var(--theme-border);
	}
	.releases__empty {
		margin: 0;
		color: var(--theme-muted);
	}

	.releases__archive {
		margin-top: 2.25rem;
		border: 1px solid var(--theme-border);
		border-radius: var(--theme-shape-radius-sm);
		overflow: hidden;
	}
	.releases__archive summary {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4rem 0.75rem;
		padding: 0.8rem 1rem;
		cursor: pointer;
		list-style: none;
	}
	.releases__archive summary::-webkit-details-marker {
		display: none;
	}
	.releases__archive summary:hover {
		background-color: var(--theme-surface-1);
	}
	.releases__archive-title {
		font-weight: 700;
	}
	.releases__archive-range {
		font-size: var(--font-size-sm);
		color: var(--theme-muted);
		font-variant-numeric: tabular-nums;
	}
	.releases__chevron {
		width: 1.1rem;
		height: 1.1rem;
		margin-left: auto;
		flex-shrink: 0;
		transition: transform var(--theme-transition);
	}
	.releases__archive[open] .releases__chevron {
		transform: rotate(180deg);
	}
	.releases--archive {
		margin: 0.5rem 1rem 1.25rem 1.5rem;
	}
</style>
