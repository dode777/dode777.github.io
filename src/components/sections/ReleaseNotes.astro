---
import MarkdownText from '../MarkdownText.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/ui.js';
import {
	downloadableVersions,
	installerDownloadUrl,
	installerFileName,
} from '../../config/services.js';
import { formatSize } from '../../lib/update-notes.js';
import { resolveReleases } from '../../lib/releases.js';

const { service } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const content = service[lang];

const { entries } = await resolveReleases(service, lang);
// 버전별 설치 파일은 Windows 프로그램에만 있습니다(웹앱은 항상 최신).
const downloadable = service.downloadKind === 'windows' ? downloadableVersions(entries) : new Set();
---

{
	entries.length > 0 ? (
		<>
			<p class="releases__note">{content.releaseNote}</p>

			<ol class="releases">
				{entries.map((release, index) => (
					<li class="releases__item">
						<div class="releases__meta">
							<span class="releases__version">v{release.version}</span>
							{index === 0 && (
								<span class="releases__latest">{t('releases.latest')}</span>
							)}
							{release.date && (
								<time class="releases__date" datetime={release.date}>
									{release.date}
								</time>
							)}
						</div>

						{release.lead && (
							<p class="releases__summary">
								<MarkdownText text={release.lead} />
							</p>
						)}

						{release.blocks.length > 0 && (
							<details class="releases__details">
								<summary>
									<span>{t('releases.details')}</span>
									<svg class="releases__chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m6 9 6 6 6-6" /></svg>
								</summary>
								<div class="releases__body">
									{release.blocks.map((block) =>
										block.type === 'heading' ? (
											<h4 class="releases__subheading">
												<MarkdownText text={block.text} />
											</h4>
										) : block.type === 'list' ? (
											<ul class="releases__changes">
												{block.items.map((item) => (
													<li>
														<MarkdownText text={item} />
													</li>
												))}
											</ul>
										) : (
											<p class="releases__paragraph">
												<MarkdownText text={block.text} />
											</p>
										)
									)}
								</div>
							</details>
						)}

						{/* 계열별 마지막 패치만, 그중에서도 최신 몇 개만 설치 파일을 제공합니다. */}
						{downloadable.has(release.version) && (
							<p class="releases__download">
								<a
									class="releases__download-link"
									href={installerDownloadUrl(release.version)}
								>
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
										<path d="M12 3.5v11" />
										<path d="M7.5 10.5 12 15l4.5-4.5" />
										<path d="M4.5 18.5h15" />
									</svg>
									{t('releases.download')}
								</a>
								<span class="releases__file">
									{installerFileName(release.version)}
									{release.size && ` · ${formatSize(release.size)}`}
								</span>
							</p>
						)}
					</li>
				))}
			</ol>
		</>
	) : (
		<p class="releases__empty">{t('releases.unavailable')}</p>
	)
}

<style>
	.releases__note {
		margin-bottom: 2rem;
		color: var(--theme-muted);
		white-space: pre-line;
	}
	.releases {
		margin: 0;
		padding: 0;
		list-style: none;
		border-left: 2px solid var(--theme-border);
	}
	.releases__item {
		position: relative;
		padding: 0 0 2.25rem 1.5rem;
	}
	.releases__item::before {
		content: '';
		position: absolute;
		top: 0.6rem;
		left: -0.4rem;
		width: 0.7rem;
		height: 0.7rem;
		border-radius: 50%;
		background-color: var(--theme-border);
	}
	.releases__item:first-child::before {
		background-color: var(--theme-primary);
	}
	.releases__item:last-child {
		padding-bottom: 0;
	}
	.releases__meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.6rem;
	}
	.releases__version {
		font-weight: 700;
		font-size: var(--font-size-md);
	}
	.releases__latest {
		padding: 0.05rem 0.6rem;
		border-radius: 3rem;
		background-color: var(--theme-badge-live-bg);
		color: var(--theme-badge-live-on);
		font-size: var(--font-size-sm);
		font-weight: 700;
	}
	.releases__date {
		font-size: var(--font-size-sm);
		color: var(--theme-muted);
	}
	.releases__summary {
		margin: 0.5rem 0 0 0;
		color: var(--theme-muted);
		white-space: pre-line;
	}

	.releases__details {
		margin-top: 0.85rem;
		border: 1px solid var(--theme-border);
		border-radius: var(--theme-shape-radius-sm);
		overflow: hidden;
	}
	.releases__details summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.7rem 1rem;
		font-size: var(--font-size-sm);
		font-weight: 700;
		cursor: pointer;
		list-style: none;
	}
	.releases__details summary::-webkit-details-marker {
		display: none;
	}
	.releases__details summary:hover {
		background-color: var(--theme-surface-1);
	}
	.releases__chevron {
		width: 1.1rem;
		height: 1.1rem;
		flex-shrink: 0;
		transition: transform var(--theme-transition);
	}
	.releases__details[open] .releases__chevron {
		transform: rotate(180deg);
	}
	.releases__body {
		padding: 0 1rem 1rem 1rem;
		font-size: var(--font-size-sm);
	}
	.releases__subheading {
		margin: 0.75rem 0 0.5rem 0;
		font-family: var(--theme-font-family-sans);
		font-size: var(--font-size-sm);
		font-weight: 700;
	}
	.releases__paragraph {
		margin: 0 0 0.6rem 0;
		color: var(--theme-muted);
		white-space: pre-line;
	}
	.releases__changes {
		margin: 0;
		padding-left: 1.1rem;
		color: var(--theme-muted);
	}
	.releases__changes li {
		margin-bottom: 0.4rem;
		white-space: pre-line;
	}
	.releases__changes li:last-child {
		margin-bottom: 0;
	}

	.releases__download {
		margin: 0.85rem 0 0 0;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.6rem 0.85rem;
	}
	.releases__download-link {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.35rem 0.9rem;
		border: 1px solid var(--theme-border);
		border-radius: 3rem;
		font-size: var(--font-size-sm);
		font-weight: 700;
		text-decoration: none;
		transition: border-color var(--theme-transition),
			background-color var(--theme-transition);
	}
	.releases__download-link:hover {
		border-color: var(--theme-primary);
		background-color: var(--theme-surface-1);
	}
	.releases__download-link svg {
		width: 1.05em;
		height: 1.05em;
	}
	.releases__file {
		font-family: var(--theme-font-family-mono);
		font-size: var(--font-size-sm);
		color: var(--theme-muted);
	}
	.releases__empty {
		margin: 0;
		color: var(--theme-muted);
	}
</style>
