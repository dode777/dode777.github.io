---
import Container from '../core/Container.astro';
import Button from '../buttons/Button.astro';
import StatusBadge from '../StatusBadge.astro';
import DownloadButton from '../DownloadButton.astro';
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/ui.js';

const { service } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const content = service[lang];

const pendingNote =
	service.downloadKind === 'chrome-store'
		? t('detail.downloadPendingStore')
		: t('detail.downloadPendingRelease');
---

<Container narrow>
	<section class="service-hero">
		<a class="service-hero__back" href={localizePath('/', lang)}>
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M15 6l-6 6 6 6" /></svg>
			{t('detail.backToHome')}
		</a>

		<div class="service-hero__meta">
			<StatusBadge status={service.status} />
			{
				service.currentVersion && (
					<span class="service-hero__version">
						{t('detail.currentVersion')} v{service.currentVersion}
					</span>
				)
			}
		</div>

		<h1 class="service-hero__title">{content.name}</h1>
		{content.subName !== content.name && <p class="service-hero__subname">{content.subName}</p>}
		<p class="service-hero__tagline">{content.tagline}</p>
		<p class="service-hero__summary">{content.summary}</p>

		<div class="service-hero__actions">
			<DownloadButton service={service} large />
			<Button href={service.repo} outlined large newTab>{t('detail.viewRepo')}</Button>
		</div>

		{!service.downloadReady && <p class="service-hero__note">{pendingNote}</p>}
	</section>
</Container>

<style>
	.service-hero {
		padding: 2.5rem 0 clamp(2rem, 6vh, 4rem) 0;
	}
	.service-hero__back {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		margin-bottom: 2rem;
		font-size: var(--font-size-sm);
		color: var(--theme-muted);
		text-decoration: none;
	}
	.service-hero__back:hover {
		color: var(--theme-on-bg);
	}
	.service-hero__back svg {
		width: 1rem;
		height: 1rem;
	}
	.service-hero__meta {
		margin-bottom: 1rem;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem;
	}
	.service-hero__version {
		font-size: var(--font-size-sm);
		color: var(--theme-muted);
	}
	.service-hero__title {
		margin-bottom: 0.25rem;
	}
	.service-hero__subname {
		margin-bottom: 1.25rem;
		color: var(--theme-muted);
	}
	.service-hero__tagline {
		margin-bottom: 1rem;
		font-size: var(--font-size-md);
		font-weight: 700;
	}
	.service-hero__summary {
		margin-bottom: 2rem;
		max-width: 52ch;
		color: var(--theme-muted);
	}
	.service-hero__actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem;
	}
	.service-hero__note {
		margin: 1rem 0 0 0;
		font-size: var(--font-size-sm);
		color: var(--theme-muted);
	}
</style>
