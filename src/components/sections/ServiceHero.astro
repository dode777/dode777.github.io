---
import Container from '../core/Container.astro';
import StatusBadge from '../StatusBadge.astro';
import DownloadButton from '../DownloadButton.astro';
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/ui.js';
import { installerFileName } from '../../config/services.js';
import { resolveReleases } from '../../lib/releases.js';

const { service } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const content = service[lang];

// 버전은 릴리스 목록과 같은 출처에서 가져와, 목록과 버튼이 어긋나지 않게 합니다.
const { latest } = await resolveReleases(service, lang);
const version = latest?.version ?? service.currentVersion;
const web = service.downloadKind === 'web';
const installer = version ? installerFileName(version) : service.installerName;
// 웹앱은 설치 파일이 없으니 앱 주소를 적고, 게시된 버전이 있을 때만 켜진 것으로 봅니다.
const webReady = web && Boolean(version);

const pendingNote =
	service.downloadKind === 'chrome-store'
		? t('detail.downloadPendingStore')
		: t('detail.downloadPendingRelease');

// 상세 페이지의 큰 제목·작은 이름. 따로 정하지 않으면 제품명·subName 을 씁니다(홈 카드·메뉴는 늘 제품명).
const pageName = content.pageName || content.name;
const pageSubName = content.pageSubName || content.subName;
// 큰 제목과 같은 한 줄 소개는 두 번 보이지 않게 뺍니다.
const same = (a, b) => String(a ?? '').trim().toLowerCase() === String(b ?? '').trim().toLowerCase();
---

<Container narrow>
	<section class="service-hero">
		<a class="service-hero__back" href={localizePath('/', lang)}>
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M15 6l-6 6 6 6" /></svg>
			{t('detail.backToHome')}
		</a>

		<div class="service-hero__meta">
			<StatusBadge status={service.status} />
			{
				version && (
					<span class="service-hero__version">
						{t('detail.currentVersion')} v{version}
					</span>
				)
			}
		</div>

		<h1 class="service-hero__title">{pageName}</h1>
		{pageSubName && pageSubName !== pageName && (
			<p class="service-hero__subname">{pageSubName}</p>
		)}
		{!same(content.tagline, pageName) && <p class="service-hero__tagline">{content.tagline}</p>}

		<div class="service-hero__actions">
			<DownloadButton service={service} version={version} large />
		</div>

		{web ? (
			webReady ? (
				<>
					<p class="service-hero__note">{new URL(service.downloadUrl).host}</p>
					<p class="service-hero__hint">{t('detail.openWebHint')}</p>
				</>
			) : (
				<p class="service-hero__note">{pendingNote}</p>
			)
		) : (
			service.downloadReady && installer ? (
				<p class="service-hero__note">{installer}</p>
			) : (
				!service.downloadReady && <p class="service-hero__note">{pendingNote}</p>
			)
		)}
	</section>
</Container>

<style>
	.service-hero {
		padding: 2.5rem 0 clamp(2rem, 6vh, 4rem) 0;
	}
	.service-hero__back {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		margin-bottom: 2rem;
		font-size: var(--font-size-sm);
		color: var(--theme-muted);
		text-decoration: none;
	}
	.service-hero__back:hover {
		color: var(--theme-on-bg);
	}
	.service-hero__back svg {
		width: 1rem;
		height: 1rem;
	}
	.service-hero__meta {
		margin-bottom: 1rem;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem;
	}
	.service-hero__version {
		font-size: var(--font-size-sm);
		color: var(--theme-muted);
	}
	.service-hero__title {
		margin-bottom: 0.25rem;
	}
	.service-hero__subname {
		margin-bottom: 1.25rem;
		color: var(--theme-muted);
	}
	.service-hero__tagline {
		margin-bottom: 2rem;
		font-size: var(--font-size-md);
		font-weight: 700;
	}
	.service-hero__actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem;
	}
	.service-hero__hint {
		margin: 0.35rem 0 0 0;
		font-size: var(--font-size-sm);
		color: var(--theme-muted);
	}
	.service-hero__note {
		margin: 1rem 0 0 0;
		font-family: var(--theme-font-family-mono);
		font-size: var(--font-size-sm);
		color: var(--theme-muted);
	}
</style>
