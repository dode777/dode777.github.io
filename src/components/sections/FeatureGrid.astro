---
import { getLangFromUrl, useTranslations } from '../../i18n/ui.js';

const { features } = Astro.props;
const t = useTranslations(getLangFromUrl(Astro.url));
---

<ul class="feature-grid">
	{
		features.map((feature) => (
			<li class="feature-grid__item">
				<h3 class="feature-grid__title">
					{feature.title}
					{feature.planned && (
						<span class="feature-grid__planned">{t('detail.featuresPlanned')}</span>
					)}
				</h3>
				<p class="feature-grid__body">{feature.body}</p>
			</li>
		))
	}
</ul>

<style>
	.feature-grid {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--theme-grid-gap);
	}
	.feature-grid__item {
		padding: 1.5rem;
		background-color: var(--theme-bg);
		border: 1px solid var(--theme-border);
		border-radius: var(--theme-shape-radius-sm);
	}
	.feature-grid__title {
		margin-bottom: 0.5rem;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		font-family: var(--theme-font-family-sans);
		font-size: var(--font-size-base);
		font-weight: 700;
	}
	.feature-grid__planned {
		padding: 0.05rem 0.55rem;
		border-radius: 3rem;
		background-color: var(--theme-badge-dev-bg);
		color: var(--theme-badge-dev-on);
		font-size: var(--font-size-sm);
		font-weight: 700;
	}
	.feature-grid__body {
		margin: 0;
		color: var(--theme-muted);
	}

	@media (max-width: 700px) {
		.feature-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
