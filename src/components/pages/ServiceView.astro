---
import Page from '../../layouts/Page.astro';
import Section from '../sections/Section.astro';
import ServiceHero from '../sections/ServiceHero.astro';
import FeatureGrid from '../sections/FeatureGrid.astro';
import Screenshots from '../sections/Screenshots.astro';
import ReleaseNotes from '../sections/ReleaseNotes.astro';
import RequirementsSection from '../sections/RequirementsSection.astro';
import FaqSection from '../sections/FaqSection.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/ui.js';

const { service } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const content = service[lang];
---

<Page title={content.name} description={content.summary}>
	<ServiceHero service={service} />

	<Section title={t('detail.overview')} id="overview">
		{content.description.map((paragraph) => <p class="service-overview__p">{paragraph}</p>)}
	</Section>

	<Section title={t('detail.features')} id="features">
		<FeatureGrid features={content.features} />
	</Section>

	<Section title={t('detail.screenshots').replace('{name}', content.name)} id="screenshots">
		<Screenshots service={service} />
	</Section>

	<Section title={t('detail.releases')} id="releases">
		<ReleaseNotes service={service} />
	</Section>

	<Section title={t('detail.requirements')} id="requirements">
		<RequirementsSection requirements={content.requirements} />
	</Section>

	<Section title={t('detail.faq')} id="faq">
		<FaqSection faq={content.faq} />
	</Section>
</Page>

<style>
	.service-overview__p {
		max-width: 62ch;
		/* 문구에 넣어 둔 줄바꿈을 그대로 살립니다. */
		white-space: pre-line;
	}
</style>
