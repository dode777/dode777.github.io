---
import Page from '../../layouts/Page.astro';
import Section from '../sections/Section.astro';
import ServiceHero from '../sections/ServiceHero.astro';
import FeatureGrid from '../sections/FeatureGrid.astro';
import Screenshots from '../sections/Screenshots.astro';
import ReleaseNotes from '../sections/ReleaseNotes.astro';
import RequirementsSection from '../sections/RequirementsSection.astro';
import FaqSection from '../sections/FaqSection.astro';
import StepsSection from '../sections/StepsSection.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/ui.js';
import settings from '../../config/settings.js';
import { installerDownloadUrl } from '../../config/services.js';
import { resolveReleases } from '../../lib/releases.js';

const { service } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const content = service[lang];
/** 서비스마다 공유 미리보기 그림이 있으면 그것을, 없으면 사이트 기본 그림 */
const ogImage = service.ogImage?.[lang];
const metaDescription = [content.summary, content.summaryDetail]
	.filter(Boolean)
	.join('. ')
	.replace('.. ', '. ');

// 제품명만으로는 검색되지 않으므로, 무엇을 하는 프로그램인지 제목에 함께 둡니다.
const metaTitle = content.metaTagline
	? `${content.name} — ${content.metaTagline}`
	: content.name;

// 버전은 히어로·릴리스 목록과 같은 출처를 씁니다(결과는 빌드 안에서 재사용됩니다).
const { latest } = await resolveReleases(service, lang);
const version = latest?.version ?? service.currentVersion;

const appSchema = {
	'@context': 'https://schema.org',
	'@type': service.schema?.type ?? 'SoftwareApplication',
	name: content.name,
	description: metaDescription,
	url: new URL(Astro.url.pathname, settings.url).href,
	applicationCategory: service.schema?.category ?? 'MultimediaApplication',
	operatingSystem: service.schema?.operatingSystem ?? 'Windows',
	inLanguage: lang === 'ko' ? 'ko-KR' : 'en',
	...(version ? { softwareVersion: version } : {}),
	...(version && service.downloadKind === 'windows'
		? { downloadUrl: installerDownloadUrl(version) }
		: {}),
	...(version && service.downloadKind === 'web' ? { installUrl: service.downloadUrl } : {}),
	// 무료입니다. price 를 빼면 검색엔진이 가격 미상으로 읽습니다.
	offers: { '@type': 'Offer', price: '0', priceCurrency: 'KRW' },
	author: { '@type': 'Person', name: settings.brand, url: settings.url },
};
---

<Page title={metaTitle} description={metaDescription} image={ogImage}>
	<Fragment slot="head">
		<script
			type="application/ld+json"
			is:inline
			set:html={JSON.stringify(appSchema)}
		/>
	</Fragment>

	<ServiceHero service={service} />

	<Section title={t('detail.overview')} id="overview">
		{content.description.map((paragraph) => <p class="service-overview__p">{paragraph}</p>)}
	</Section>

	<Section title={t('detail.features')} id="features">
		<FeatureGrid features={content.features} />
	</Section>

	<Section title={t('detail.screenshots').replace('{name}', content.name)} id="screenshots">
		<Screenshots service={service} />
	</Section>

	{
		content.installSteps && (
			<Section title={content.installTitle} id="install">
				<StepsSection steps={content.installSteps} />
			</Section>
		)
	}

	<Section title={t('detail.releases')} id="releases">
		<ReleaseNotes service={service} />
	</Section>

	<Section title={t('detail.requirements')} id="requirements">
		<RequirementsSection requirements={content.requirements} />
	</Section>

	<Section title={t('detail.faq')} id="faq">
		<FaqSection faq={content.faq} />
	</Section>
</Page>

<style>
	.service-overview__p {
		max-width: 62ch;
		/* 문구에 넣어 둔 줄바꿈을 그대로 살립니다. */
		white-space: pre-line;
	}
</style>
