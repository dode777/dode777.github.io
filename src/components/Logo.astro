---
import settings from '../config/settings.js';
---

<span class="logo">
	<svg
		class="logo__mark"
		viewBox="0 0 32 32"
		fill="none"
		aria-hidden="true"
		focusable="false"
	>
		<rect x="1.25" y="1.25" width="29.5" height="29.5" rx="9" stroke="currentColor" stroke-width="2.5"></rect>
		<circle cx="16" cy="16" r="6.25" fill="currentColor"></circle>
	</svg>
	<span class="logo__text">{settings.brand}</span>
</span>

<style>
	.logo {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-weight: 700;
		font-size: var(--font-size-base);
		letter-spacing: -0.01em;
		white-space: nowrap;
	}
	.logo__mark {
		width: 1.6rem;
		height: 1.6rem;
		flex-shrink: 0;
	}
</style>
