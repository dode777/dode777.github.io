---
import ThemeProvider from '../theme-switcher/ThemeProvider.astro';
import settings from '../../config/settings.js';
import { siteDescription } from '../../lib/site-meta.js';
import {
	languages,
	getLangFromUrl,
	useTranslations,
	localizePath,
	stripLangFromPath,
} from '../../i18n/ui.js';

import '../../styles/index.css';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { title, description, noindex, image } = Astro.props;

const pageTitle = title ? `${title} | ${t('site.title')}` : t('site.metaTitle');
const siteDesc = siteDescription(lang);
const pageDescription = description ?? siteDesc;

/**
 * 배포된 주소는 모두 끝에 슬래시가 붙습니다(build.format: 'directory').
 * canonical · hreflang · 사이트맵이 한 글자도 다르지 않아야 같은 페이지로 묶입니다.
 */
const withSlash = (pathname) => (pathname.endsWith('/') ? pathname : `${pathname}/`);

const siteURL = Astro.site ?? new URL(settings.url);
const canonicalURL = new URL(withSlash(Astro.url.pathname), siteURL);
const basePath = stripLangFromPath(Astro.url.pathname);
const ogImageURL = new URL(image ?? settings.ogImage.src[lang], siteURL);

const webSiteSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: t('site.title'),
	url: siteURL.href,
	description: siteDesc,
	inLanguage: lang === 'ko' ? 'ko-KR' : 'en',
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{pageTitle}</title>
<meta name="title" content={pageTitle} />
<meta name="description" content={pageDescription} />
<link rel="canonical" href={canonicalURL} />
{noindex && <meta name="robots" content="noindex" />}

{
	Object.keys(languages).map((code) => (
		<link
			rel="alternate"
			hreflang={code}
			href={new URL(withSlash(localizePath(basePath, code)), siteURL).href}
		/>
	))
}
<link
	rel="alternate"
	hreflang="x-default"
	href={new URL(withSlash(localizePath(basePath, 'ko')), siteURL).href}
/>

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />

<!--
	본문·제목 모두 Pretendard 입니다. 글꼴 파일을 저장소에 직접 담아 두었으므로
	외부 서비스에 기대지 않습니다. 가변 폰트를 유니코드 구간별로 쪼갠 것이라
	브라우저는 그 페이지에 실제로 쓰인 글자가 든 조각만 내려받습니다.
-->
<link rel="stylesheet" href="/assets/fonts/pretendard/pretendard.css" />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={t('site.title')} />
<meta property="og:locale" content={lang === 'ko' ? 'ko_KR' : 'en_US'} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={pageDescription} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:image:width" content={String(settings.ogImage.width)} />
<meta property="og:image:height" content={String(settings.ogImage.height)} />
<meta property="og:image:alt" content={pageTitle} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={pageDescription} />
<meta name="twitter:image" content={ogImageURL} />

<script
	type="application/ld+json"
	is:inline
	set:html={JSON.stringify(webSiteSchema)}
/>

<slot />

<ThemeProvider />
