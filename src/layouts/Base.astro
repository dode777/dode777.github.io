---
import BaseHead from '../components/head/BaseHead.astro';
import SkipLink from '../components/core/SkipLink.astro';
import { getLangFromUrl } from '../i18n/ui.js';

const lang = getLangFromUrl(Astro.url);
const { title, description, noindex } = Astro.props;
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={title} description={description} noindex={noindex} />
	</head>
	<body>
		<SkipLink />
		<slot name="header" />
		<main id="content">
			<slot />
		</main>
		<slot name="footer" />
	</body>
</html>
